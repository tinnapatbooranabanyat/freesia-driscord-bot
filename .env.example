# ===== Discord =====
# Token ของบอทจาก https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=ใส่_token_ของบอทตรงนี้

# (ไม่บังคับ) ใส่ ID เซิร์ฟเวอร์เพื่อให้ slash command ขึ้นทันทีระหว่างทดสอบ
# ถ้าเว้นว่าง คำสั่งจะ sync แบบ global (ปกติขึ้นภายในไม่กี่นาที)
DEV_GUILD_ID=

# ===== LLM (ใช้ API แบบ OpenAI-compatible ได้ทุกเจ้า) =====
# --- ตัวเลือกที่ 1 (แนะนำ): Groq ฟรี เร็วมาก  -> สมัคร key ที่ https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# ใส่ได้หลายโมเดลคั่นด้วย , ถ้าตัวแรกโดน rate limit จะสลับไปตัวถัดไปให้อัตโนมัติ
LLM_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# ให้ AI ค้นเว็บได้เอง (ใช้ได้กับโมเดล openai/gpt-oss-* บน Groq) - ค้นแต่ละครั้งใช้ token เยอะ ตั้ง false เพื่อปิด
LLM_WEB_SEARCH=true

# --- ตัวเลือกที่ 2: Google Gemini ฟรี -> key ที่ https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=...
# LLM_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite

# --- ตัวเลือกที่ 3: OpenRouter (โมเดลที่ลงท้าย :free) -> key ที่ https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=...
# LLM_MODEL=openrouter/free

# ===== อ่านรูปภาพ (ไม่บังคับ) =====
# โมเดลฟรีของ Groq มองไม่เห็นรูป ถ้าอยากให้บอทอ่านรูปได้ ให้ใส่ Gemini API key ฟรีจาก https://aistudio.google.com/apikey
GEMINI_API_KEY=
VISION_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite

# บุคลิกเริ่มต้นของบอท (เว้นว่างเพื่อใช้ค่าเริ่มต้น) - แอดมินแต่ละเซิร์ฟเวอร์ตั้งแยกได้ด้วย /persona
SYSTEM_PROMPT=
# จำนวนคู่ถาม-ตอบล่าสุดที่บอทจำไว้ต่อห้อง (เก็บใน data/bot.db ไม่หายตอนรีสตาร์ต)
CHAT_HISTORY_TURNS=6
LLM_MAX_TOKENS=1500
# จำกัดการใช้ AI ต่อคน: ได้ AI_USER_LIMIT ครั้ง ต่อ AI_USER_WINDOW วินาที (0 = ไม่จำกัด)
AI_USER_LIMIT=5
AI_USER_WINDOW=60

# ===== เพลง =====
# ปล่อยว่างถ้า ffmpeg อยู่ใน PATH แล้ว
FFMPEG_PATH=ffmpeg
DEFAULT_VOLUME=50
# วินาทีที่บอทจะรอเมื่อคิวว่าง/อยู่คนเดียวในห้องก่อนออกจากห้องเสียง
IDLE_TIMEOUT=180
# (ไม่บังคับ) ไฟล์ cookies.txt ของ YouTube - ใช้เมื่อรันบนคลาวด์แล้วเจอ "Sign in to confirm you're not a bot"
YTDL_COOKIES=

# ===== อื่นๆ =====
# โมเดลถอดข้อความเสียง (Whisper ของ Groq ใช้ฟรี)
WHISPER_MODEL=whisper-large-v3-turbo
# ID ผู้ใช้ Discord ที่จะให้บอท DM แจ้งเมื่อมีปัญหา (เว้นว่าง = เจ้าของแอปใน Developer Portal)
OWNER_ID=
# การ์ดต้อนรับสมาชิกใหม่ต้องเปิด "Server Members Intent" ใน Developer Portal
# ถ้ายังไม่เปิด บอทจะรันต่อได้ปกติแต่ไม่มีการ์ดต้อนรับ (ตั้ง false เพื่อปิดการขอสิทธิ์นี้ไปเลย)
MEMBERS_INTENT=true

# ===== Hosting =====
# ถ้าโฮสต์บังคับให้มีเว็บพอร์ต (เช่น Render / Koyeb) ให้ใส่ PORT แล้วบอทจะเปิด health check ให้
PORT=
